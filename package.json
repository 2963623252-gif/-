{
  "name": "skill-manager",
  "version": "1.0.0",
  "description": "Agent Skill 管理器：扫描、查看并启用/禁用本地各类 Agent skills，默认内置 Codex 配对示例。",
  "main": "src/main.js",
  "author": "29636",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "scan": "node src/scan-cli.js"
  },
  "devDependencies": {
    "electron": "^31.7.7"
  },
  "build": {
    "appId": "com.local.skill-manager",
    "productName": "skill管理器",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "skill管理器"
    }
  }
}
